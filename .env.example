# =============================================================================
# Portfolio environment template
# Copy to `.env` and fill values. Never commit real secrets.
# Cloud Run: mount the same names via Secret Manager (see scripts/wire-*.sh).
# =============================================================================

# --- Site identity / Express -------------------------------------------------

# Public site URL — Origin/CORS allowlist, email links, OG fallbacks.
APP_URL="https://www.mohammedsufyan.com"

# Express listen port (local default 3000; Cloud Run sets PORT=8080).
# PORT="3000"

# Node environment (`development` | `production`).
# NODE_ENV="development"

# Trust X-Forwarded-* hop count behind Cloudflare / load balancer (prod: 1).
# TRUST_PROXY="1"

# When true in production, /api/health and /api/uptime return 503 if gold-path
# secrets (Turnstile, Redis, Admin, mail, Sentry, Slack, SESSION_SECRET) are missing.
# STRICT_PROD_HARDENING="true"

# HMAC secret for OTP challenges + chat session receipts. Required in production
# (server refuses to boot without it). Use a long random 32+ byte value.
SESSION_SECRET=""

# --- Contact destination -----------------------------------------------------

# Inbox that receives verified contact inquiries and owner alerts.
CONTACT_TO_EMAIL="sufyan.net@gmail.com"

# --- Mail transport (configure at least one) ---------------------------------

# Option A — Gmail SMTP (16-character Google App Password; spaces allowed).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option B — Resend API (preferred when domain SPF/DKIM is verified).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Option C — Custom SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- Bot challenge (Cloudflare Turnstile) ------------------------------------

# Server-side Turnstile secret (siteverify). Required in production (fail-closed).
# Local/dev may omit to skip verification.
TURNSTILE_SECRET_KEY=""

# Public Turnstile site key for Vite client widgets (Contact, CV gate, chat).
VITE_TURNSTILE_SITE_KEY=""

# Optional server-only alias if the public key is not baked into the client bundle.
# TURNSTILE_SITE_KEY=""

# --- CV / form policy toggles ------------------------------------------------

# Force 6-digit email OTP for every CV / PWA install gate (default: adaptive).
FORCE_CV_OTP="false"

# Allow FormSubmit third-party PII relay in production (keep false).
ALLOW_FORMSUBMIT_FALLBACK="false"

# --- Firebase Admin (server PII writes + reply binding) ----------------------

# Inline JSON string for the Firebase Admin service account (Cloud Run secret).
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Or path to a local service-account JSON file (local/dev only).
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/firebase-adminsdk.json"

# --- Firebase web client (public browser keys — restrict in Google Cloud) ----

# Firebase Web API key for the SPA (Vite build). Do not commit the real value;
# restrict by HTTP referrer in Google Cloud Console / Firebase.
VITE_FIREBASE_API_KEY=""

# --- Firebase App Check (reCAPTCHA Enterprise — public site key) -------------

# Vite client App Check site key (prefer env over committing in JSON).
VITE_RECAPTCHA_SITE_KEY=""

# Server/health alias for the same reCAPTCHA Enterprise site key.
RECAPTCHA_SITE_KEY=""

# --- Upstash Redis (shared rate limits / policy / OTP / chat sessions) -------

# REST URL for the Upstash Redis database.
UPSTASH_REDIS_REST_URL=""

# REST token for Upstash Redis (fail-closed rate limits when set).
UPSTASH_REDIS_REST_TOKEN=""

# --- Upstash Vector (portfolio chat RAG) -------------------------------------

# REST URL for the Upstash Vector index (built-in BGE embeddings).
UPSTASH_VECTOR_REST_URL=""

# REST token for Upstash Vector (semantic retrieve; keyword fallback if unset).
UPSTASH_VECTOR_REST_TOKEN=""

# --- Grok / xAI (optional chat LLM enrichment) -------------------------------

# xAI API key (must start with xai-…). Create at https://console.x.ai
# Grok subscription / Cursor-type grok_ keys are rejected by api.x.ai.
GROK_API_KEY=""

# xAI API base URL (chat completions).
GROK_API_BASE_URL="https://api.x.ai/v1"

# Timeout in ms for a single Grok enrichment call (default 12000).
CHAT_LLM_TIMEOUT_MS="12000"

# Owner Console still gates LLM with enableChatLlm + per-visitor caps.
# Wire secrets to Cloud Run: ./scripts/wire-chat-llm-secrets.sh

# --- Observability -----------------------------------------------------------

# Sentry DSN for server error reporting (optional gold path).
SENTRY_DSN=""

# Slack incoming webhook for owner alerts (optional gold path).
SLACK_ALERT_WEBHOOK_URL=""
