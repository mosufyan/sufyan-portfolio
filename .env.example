# APP_URL: Public site URL (used for Origin allowlist + email fallbacks).
APP_URL="https://www.mohammedsufyan.com"

# Contact Form Direct Email Delivery (configure one option in secrets)
CONTACT_TO_EMAIL="sufyan.net@gmail.com"

# Option A: Gmail SMTP (recommended with a 16-character Google App Password)
GMAIL_USER="sufyan.net@gmail.com"
GMAIL_APP_PASSWORD="MY_GMAIL_APP_PASSWORD"

# Option B: Resend API
RESEND_API_KEY="MY_RESEND_API_KEY"
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Option C: Custom SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optional: Cloudflare Turnstile (server verifies when set; skip otherwise)
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# Optional: Force 6-digit Email OTP for all CV downloads (default: adaptive VPN/suspicious step-up)
FORCE_CV_OTP="false"

# Optional: allow FormSubmit third-party PII relay in production (default: off)
ALLOW_FORMSUBMIT_FALLBACK="false"

# Express trust proxy hops behind a load balancer (production default: 1)
# TRUST_PROXY="1"

