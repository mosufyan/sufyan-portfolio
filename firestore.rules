rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // App Check attestation (pair with Firebase Console enforcement for Firestore).
    // Admin SDK / trusted server writes bypass rules entirely.
    function hasAppCheck() {
      return request.app != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Zero-DB-read owner identity check for list rules (Denial-of-Wallet & Pillar 8 compliant)
    function isVerifiedOwnerEmail() {
      return isVerifiedUser() && request.auth.token.email == 'sufyan.net@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'sufyan.net@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Web/mobile SDKs write whole numbers as floats; `is int` alone rejects them.
    function isWholeNumber(value) {
      return (value is int || value is float) && value == int(value);
    }

    // Public portfolio announcements only (drafts stay admin-private).
    function isPubliclyVisibleAnnouncement() {
      return !('status' in resource.data)
        || resource.data.status == 'published'
        || (
          resource.data.status == 'scheduled'
          && resource.data.scheduledAtMs is int
          && resource.data.scheduledAtMs > 0
          && resource.data.scheduledAtMs <= request.time.toMillis()
        );
    }

    // Strict schema for announcements. Create requires authorUid == caller;
    // updates only require a stable non-empty authorUid (must match existing()).
    function isValidAnnouncementShape(data, requireAuthorIsCaller) {
      return data.keys().hasAll([
          'date', 'title', 'summary', 'badge', 'linkUrl', 'status', 'scheduledAtMs',
          'authorUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'date', 'title', 'summary', 'badge', 'linkUrl', 'status', 'scheduledAtMs',
          'authorUid', 'createdAt', 'updatedAt'
        ])
        && data.date is string
        && data.date.size() >= 3
        && data.date.size() <= 40
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 180
        && data.summary is string
        && data.summary.size() >= 10
        && data.summary.size() <= 600
        && data.badge is string
        && data.badge.size() >= 5
        && data.badge.size() <= 16
        && data.badge in ['VERIFIED', 'MILESTONE', 'CERTIFICATION', 'AWARD', 'PUBLICATION']
        && data.linkUrl is string
        && data.linkUrl.size() <= 300
        && (data.linkUrl == '' || data.linkUrl.matches('^https://[^\\s]+$'))
        && data.status is string
        && data.status in ['draft', 'scheduled', 'published']
        && isWholeNumber(data.scheduledAtMs)
        && data.scheduledAtMs >= 0
        && data.authorUid is string
        && data.authorUid.size() >= 1
        && data.authorUid.size() <= 128
        && (!requireAuthorIsCaller || data.authorUid == request.auth.uid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Strict schema validation blueprint for CvDownloadLog (immutable create)
    function isValidCvDownloadLog(data, pathId) {
      return data.keys().hasAll([
          'downloadId', 'sessionId', 'visitorName', 'visitorEmail', 'visitorPhone',
          'reason', 'action', 'formatLabel', 'theme', 'verificationStatus',
          'ipAddress', 'country', 'region', 'city', 'isp', 'asn',
          'timezone', 'clientTimezone', 'isVpnSuspected', 'isProxy',
          'isHosting', 'timezoneMismatch', 'riskLevel', 'riskReasons',
          'referrer', 'userAgent', 'isSubsequent', 'createdAt'
        ])
        && data.keys().hasOnly([
          'downloadId', 'sessionId', 'visitorName', 'visitorEmail', 'visitorPhone',
          'reason', 'action', 'formatLabel', 'theme', 'verificationStatus',
          'ipAddress', 'country', 'region', 'city', 'isp', 'asn',
          'timezone', 'clientTimezone', 'isVpnSuspected', 'isProxy',
          'isHosting', 'timezoneMismatch', 'riskLevel', 'riskReasons',
          'referrer', 'userAgent', 'isSubsequent', 'createdAt'
        ])
        && data.downloadId is string
        && data.downloadId == pathId
        && data.downloadId.size() >= 4
        && data.downloadId.size() <= 64
        && data.downloadId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.sessionId is string
        && data.sessionId.size() >= 4
        && data.sessionId.size() <= 64
        && data.sessionId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.visitorName is string && data.visitorName.size() <= 120
        && data.visitorEmail is string && data.visitorEmail.size() <= 254
        && data.visitorPhone is string && data.visitorPhone.size() <= 40
        && (data.visitorEmail.size() > 0 || data.visitorPhone.size() > 0)
        && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 500
        && data.action is string && data.action.size() >= 3 && data.action.size() <= 16
        && data.action in ['pdf', 'print', 'ats', 'install']
        && data.formatLabel is string && data.formatLabel.size() >= 2 && data.formatLabel.size() <= 80
        && data.theme is string && data.theme.size() >= 4 && data.theme.size() <= 8
        && data.theme in ['dark', 'light']
        && data.verificationStatus is string && data.verificationStatus.size() >= 4 && data.verificationStatus.size() <= 24
        && data.verificationStatus in ['otp_verified', 'mx_verified', 'phone_only', 'repeat_session']
        && data.ipAddress is string && data.ipAddress.size() <= 64
        && data.country is string && data.country.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.city is string && data.city.size() <= 80
        && data.isp is string && data.isp.size() <= 120
        && data.asn is string && data.asn.size() <= 64
        && data.timezone is string && data.timezone.size() <= 64
        && data.clientTimezone is string && data.clientTimezone.size() <= 64
        && data.isVpnSuspected is bool
        && data.isProxy is bool
        && data.isHosting is bool
        && data.timezoneMismatch is bool
        && data.riskLevel is string && data.riskLevel.size() >= 3 && data.riskLevel.size() <= 10
        && data.riskLevel in ['low', 'medium', 'high']
        && data.riskReasons is string && data.riskReasons.size() <= 240
        && data.referrer is string && data.referrer.size() <= 200
        && data.userAgent is string && data.userAgent.size() <= 220
        && data.isSubsequent is bool
        && data.createdAt is timestamp;
    }

    // Strict schema validation blueprint for ContactMessageLog (immutable core create + owner-only triage update)
    function isValidContactMessageLog(data, pathId) {
      return data.keys().hasAll([
          'messageId', 'senderName', 'senderEmail', 'senderPhone',
          'subject', 'message', 'theme',
          'ipAddress', 'country', 'region', 'city', 'isp', 'asn',
          'timezone', 'clientTimezone', 'isVpnSuspected',
          'riskLevel', 'riskReasons', 'referrer', 'userAgent', 'createdAt'
        ])
        && data.keys().hasOnly([
          'messageId', 'senderName', 'senderEmail', 'senderPhone',
          'subject', 'message', 'theme',
          'ipAddress', 'country', 'region', 'city', 'isp', 'asn',
          'timezone', 'clientTimezone', 'isVpnSuspected',
          'riskLevel', 'riskReasons', 'referrer', 'userAgent',
          'triageStatus', 'ownerNote', 'triagedAt', 'createdAt',
          'leadCompany', 'leadRole', 'leadSource', 'leadPriority',
          'leadNextAction', 'leadNextActionDueAtMs', 'leadOutcome'
        ])
        && data.messageId is string
        && data.messageId == pathId
        && data.messageId.size() >= 4
        && data.messageId.size() <= 64
        && data.messageId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120
        && data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 254
        && data.senderPhone is string && data.senderPhone.size() <= 40
        && data.subject is string && data.subject.size() <= 200
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 5000
        && data.theme is string && data.theme.size() >= 4 && data.theme.size() <= 8
        && data.theme in ['dark', 'light']
        && data.ipAddress is string && data.ipAddress.size() <= 64
        && data.country is string && data.country.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.city is string && data.city.size() <= 80
        && data.isp is string && data.isp.size() <= 120
        && data.asn is string && data.asn.size() <= 64
        && data.timezone is string && data.timezone.size() <= 64
        && data.clientTimezone is string && data.clientTimezone.size() <= 64
        && data.isVpnSuspected is bool
        && data.riskLevel is string && data.riskLevel.size() >= 3 && data.riskLevel.size() <= 10
        && data.riskLevel in ['low', 'medium', 'high']
        && data.riskReasons is string && data.riskReasons.size() <= 240
        && data.referrer is string && data.referrer.size() <= 200
        && data.userAgent is string && data.userAgent.size() <= 220
        && (!('triageStatus' in data) || (data.triageStatus is string && data.triageStatus.size() >= 3 && data.triageStatus.size() <= 16 && data.triageStatus in ['new', 'replied', 'shortlisted', 'archived']))
        && (!('ownerNote' in data) || (data.ownerNote is string && data.ownerNote.size() <= 1000))
        && (!('triagedAt' in data) || data.triagedAt is timestamp)
        && (!('leadCompany' in data) || (data.leadCompany is string && data.leadCompany.size() <= 120))
        && (!('leadRole' in data) || (data.leadRole is string && data.leadRole.size() <= 120))
        && (!('leadSource' in data) || (data.leadSource is string && data.leadSource in ['', 'linkedin', 'referral', 'organic', 'other']))
        && (!('leadPriority' in data) || (data.leadPriority is string && data.leadPriority in ['', 'hot', 'warm', 'cold']))
        && (!('leadNextAction' in data) || (data.leadNextAction is string && data.leadNextAction.size() <= 200))
        && (!('leadNextActionDueAtMs' in data) || (isWholeNumber(data.leadNextActionDueAtMs) && data.leadNextActionDueAtMs >= 0))
        && (!('leadOutcome' in data) || (data.leadOutcome is string && data.leadOutcome in ['', 'open', 'interview', 'offer', 'closed_won', 'closed_lost']))
        && data.createdAt is timestamp;
    }

    // Strict schema validation blueprint for AdminAuditLog (owner-only immutable create)
    function isValidAdminAuditLog(data, pathId) {
      return data.keys().hasAll([
          'auditId', 'eventType', 'actorEmail', 'actorUid',
          'summary', 'userAgent', 'timezone', 'hostname', 'createdAt'
        ])
        && data.keys().hasOnly([
          'auditId', 'eventType', 'actorEmail', 'actorUid',
          'summary', 'userAgent', 'timezone', 'hostname', 'createdAt'
        ])
        && data.auditId is string
        && data.auditId == pathId
        && data.auditId.size() >= 4
        && data.auditId.size() <= 64
        && data.auditId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.eventType is string
        && data.eventType.size() >= 4
        && data.eventType.size() <= 32
        && data.eventType in [
          'owner_login', 'owner_logout', 'settings_updated',
          'rule_created', 'rule_deleted', 'triage_updated', 'announcement_mutated',
          'owner_reply_sent', 'delegate_added', 'delegate_removed', 'incident_mode_toggled'
        ]
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 254
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 && data.actorUid == request.auth.uid
        && data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 240
        && data.userAgent is string && data.userAgent.size() <= 220
        && data.timezone is string && data.timezone.size() <= 64
        && data.hostname is string && data.hostname.size() <= 120
        && data.createdAt is timestamp;
    }

    // Strict schema validation blueprint for PortfolioSettings (singleton 'global' doc)
    function isValidPortfolioSettings(data) {
      return data.keys().hasAll([
          'availabilityStatus', 'availabilityText', 'maintenanceMode', 'maintenanceMessage',
          'enableContactForm', 'enableCvDownloads', 'strictOtpForAll',
          'requireOtpForChat', 'requireOtpForContact', 'requireOtpForCv',
          'showAnnouncementsBadge',
          'enableAnnouncements', 'enableResumeStudio', 'enableDigitalCard', 'enableCommandPalette',
          'enableTerminal', 'enablePwaInstall', 'enableSkillFilter', 'enableReadingModes',
          'enableScrollHud', 'enableSiteTelemetry',
          'incidentMode', 'incidentMessage', 'notifyOnNewInquiry',
          'enablePortfolioChat', 'enableLiveChat', 'enableChatLlm', 'enableVoiceAgent',
          'enableVoiceRealtime',
          'chatMaxQuestionsPerVisitor', 'chatMaxLlmPerVisitor', 'chatMaxLiveSessionsPerVisitor',
          'chatMaxVoiceTurnsPerVisitor',
          'chatMaxVoiceRealtimeSessionsPerVisitor', 'chatMaxVoiceRealtimeMinutesPerVisitor',
          'chatRateWindowHours', 'chatLlmModel',
          'voiceSttModel', 'voiceTtsVoiceId', 'voiceRealtimeModel',
          'chatShowSuggestions', 'chatOfferLiveAgent',
          'alertEmailEnabled', 'alertEmailUrgent', 'alertEmailWarning', 'alertEmailDigest',
          'alertClassNewInquiry', 'alertClassLiveChat', 'alertClassRiskDownload',
          'alertClassUnusualTraffic', 'alertClassChatLimit', 'alertClassOverdueCrm',
          'updatedByUid', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'availabilityStatus', 'availabilityText', 'maintenanceMode', 'maintenanceMessage',
          'enableContactForm', 'enableCvDownloads', 'strictOtpForAll',
          'requireOtpForChat', 'requireOtpForContact', 'requireOtpForCv',
          'showAnnouncementsBadge',
          'enableAnnouncements', 'enableResumeStudio', 'enableDigitalCard', 'enableCommandPalette',
          'enableTerminal', 'enablePwaInstall', 'enableSkillFilter', 'enableReadingModes',
          'enableScrollHud', 'enableSiteTelemetry',
          'incidentMode', 'incidentMessage', 'notifyOnNewInquiry',
          'enablePortfolioChat', 'enableLiveChat', 'enableChatLlm', 'enableVoiceAgent',
          'enableVoiceRealtime',
          'chatMaxQuestionsPerVisitor', 'chatMaxLlmPerVisitor', 'chatMaxLiveSessionsPerVisitor',
          'chatMaxVoiceTurnsPerVisitor',
          'chatMaxVoiceRealtimeSessionsPerVisitor', 'chatMaxVoiceRealtimeMinutesPerVisitor',
          'chatRateWindowHours', 'chatLlmModel',
          'voiceSttModel', 'voiceTtsVoiceId', 'voiceRealtimeModel',
          'chatShowSuggestions', 'chatOfferLiveAgent',
          'alertEmailEnabled', 'alertEmailUrgent', 'alertEmailWarning', 'alertEmailDigest',
          'alertClassNewInquiry', 'alertClassLiveChat', 'alertClassRiskDownload',
          'alertClassUnusualTraffic', 'alertClassChatLimit', 'alertClassOverdueCrm',
          'updatedByUid', 'updatedAt'
        ])
        && data.availabilityStatus is string
        && data.availabilityStatus.size() >= 4
        && data.availabilityStatus.size() <= 16
        && data.availabilityStatus in ['open', 'advisory', 'unavailable']
        && data.availabilityText is string && data.availabilityText.size() <= 140
        && data.maintenanceMode is bool
        && data.maintenanceMessage is string && data.maintenanceMessage.size() <= 300
        && data.enableContactForm is bool
        && data.enableCvDownloads is bool
        && data.strictOtpForAll is bool
        && data.requireOtpForChat is bool
        && data.requireOtpForContact is bool
        && data.requireOtpForCv is bool
        && data.showAnnouncementsBadge is bool
        && data.enableAnnouncements is bool
        && data.enableResumeStudio is bool
        && data.enableDigitalCard is bool
        && data.enableCommandPalette is bool
        && data.enableTerminal is bool
        && data.enablePwaInstall is bool
        && data.enableSkillFilter is bool
        && data.enableReadingModes is bool
        && data.enableScrollHud is bool
        && data.enableSiteTelemetry is bool
        && data.incidentMode is bool
        && data.incidentMessage is string && data.incidentMessage.size() <= 300
        && data.notifyOnNewInquiry is bool
        && data.enablePortfolioChat is bool
        && data.enableLiveChat is bool
        && data.enableChatLlm is bool
        && data.enableVoiceAgent is bool
        && data.enableVoiceRealtime is bool
        && isWholeNumber(data.chatMaxQuestionsPerVisitor)
        && data.chatMaxQuestionsPerVisitor >= 1
        && data.chatMaxQuestionsPerVisitor <= 200
        && isWholeNumber(data.chatMaxLlmPerVisitor)
        && data.chatMaxLlmPerVisitor >= 0
        && data.chatMaxLlmPerVisitor <= 100
        && isWholeNumber(data.chatMaxLiveSessionsPerVisitor)
        && data.chatMaxLiveSessionsPerVisitor >= 0
        && data.chatMaxLiveSessionsPerVisitor <= 50
        && isWholeNumber(data.chatMaxVoiceTurnsPerVisitor)
        && data.chatMaxVoiceTurnsPerVisitor >= 0
        && data.chatMaxVoiceTurnsPerVisitor <= 50
        && isWholeNumber(data.chatMaxVoiceRealtimeSessionsPerVisitor)
        && data.chatMaxVoiceRealtimeSessionsPerVisitor >= 0
        && data.chatMaxVoiceRealtimeSessionsPerVisitor <= 20
        && isWholeNumber(data.chatMaxVoiceRealtimeMinutesPerVisitor)
        && data.chatMaxVoiceRealtimeMinutesPerVisitor >= 0
        && data.chatMaxVoiceRealtimeMinutesPerVisitor <= 120
        && isWholeNumber(data.chatRateWindowHours)
        && data.chatRateWindowHours >= 1
        && data.chatRateWindowHours <= 168
        && data.chatLlmModel is string
        && data.chatLlmModel.size() <= 64
        && data.voiceSttModel is string
        && data.voiceSttModel.size() <= 64
        && data.voiceTtsVoiceId is string
        && data.voiceTtsVoiceId.size() <= 64
        && data.voiceRealtimeModel is string
        && data.voiceRealtimeModel.size() <= 64
        && data.chatShowSuggestions is bool
        && data.chatOfferLiveAgent is bool
        && data.alertEmailEnabled is bool
        && data.alertEmailUrgent is bool
        && data.alertEmailWarning is bool
        && data.alertEmailDigest is bool
        && data.alertClassNewInquiry is string
        && data.alertClassNewInquiry in ['urgent', 'warning', 'digest', 'off']
        && data.alertClassLiveChat is string
        && data.alertClassLiveChat in ['urgent', 'warning', 'digest', 'off']
        && data.alertClassRiskDownload is string
        && data.alertClassRiskDownload in ['urgent', 'warning', 'digest', 'off']
        && data.alertClassUnusualTraffic is string
        && data.alertClassUnusualTraffic in ['urgent', 'warning', 'digest', 'off']
        && data.alertClassChatLimit is string
        && data.alertClassChatLimit in ['urgent', 'warning', 'digest', 'off']
        && data.alertClassOverdueCrm is string
        && data.alertClassOverdueCrm in ['urgent', 'warning', 'digest', 'off']
        && data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 && data.updatedByUid == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, pathId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdByUid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdByUid', 'createdAt'])
        && data.uid is string
        && data.uid == pathId
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.role is string
        && data.role == 'admin'
        && data.createdByUid is string
        && data.createdByUid.size() >= 1
        && data.createdByUid.size() <= 128
        && data.createdByUid == request.auth.uid
        && data.createdAt is timestamp;
    }

    // Strict schema validation blueprint for AccessRule (owner-only allowlist/blocklist)
    function isValidAccessRule(data, pathId) {
      return data.keys().hasAll([
          'ruleId', 'ruleType', 'matchType', 'value', 'note', 'createdByUid', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ruleId', 'ruleType', 'matchType', 'value', 'note', 'createdByUid', 'createdAt'
        ])
        && data.ruleId is string
        && data.ruleId == pathId
        && data.ruleId.size() >= 4
        && data.ruleId.size() <= 64
        && data.ruleId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ruleType is string && data.ruleType.size() >= 4 && data.ruleType.size() <= 8 && data.ruleType in ['allow', 'block']
        && data.matchType is string && data.matchType.size() >= 2 && data.matchType.size() <= 10 && data.matchType in ['email', 'domain', 'ip']
        && data.value is string && data.value.size() >= 2 && data.value.size() <= 254
        && data.note is string && data.note.size() <= 200
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 && data.createdByUid == request.auth.uid
        && data.createdAt is timestamp;
    }

    // Portfolio Announcements — public list/get use isPubliclyVisibleAnnouncement()
    // (published, legacy missing status, or scheduled with scheduledAtMs <= now).
    // Clients must query in a way that only returns rule-satisfying docs (published
    // query and/or scheduled + scheduledAtMs <= now); drafts stay admin-only.
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (isAdmin() || isPubliclyVisibleAnnouncement());
      allow list: if isAdmin() || isPubliclyVisibleAnnouncement();

      // hasAppCheck() is available for Console-enforced App Check; client init is
      // optional via VITE_RECAPTCHA_SITE_KEY. Do not hard-require here so local
      // deploys without App Check keep working; enable Enforcement in Firebase Console.
      allow create: if isVerifiedUser()
        && isValidId(announcementId)
        && isValidAnnouncementShape(incoming(), true)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isVerifiedUser()
        && isValidId(announcementId)
        && isValidAnnouncementShape(incoming(), false)
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'date', 'title', 'summary', 'badge', 'linkUrl', 'status', 'scheduledAtMs', 'updatedAt'
        ])
        && isAdmin();

      allow delete: if isVerifiedUser()
        && isValidId(announcementId)
        && isAdmin();
    }

    // CV Download telemetry — client creates denied (Admin SDK / server writes only).
    match /cv_downloads/{downloadId} {
      allow get: if isVerifiedUser() && isValidId(downloadId) && isAdmin();
      allow list: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(downloadId)
        && isAdmin();
    }

    // Contact inquiry logs — client creates denied (Admin SDK / server writes only).
    match /contact_messages/{messageId} {
      allow get: if isVerifiedUser() && isValidId(messageId) && isAdmin();
      allow list: if isAdmin();
      allow create: if false;

      // Validate only triage/CRM patch fields — older Admin-written docs may lack
      // lead_* keys, so requiring the full create schema here blocked owner replies.
      allow update: if isVerifiedUser()
        && isValidId(messageId)
        && isAdmin()
        && incoming().createdAt == existing().createdAt
        && incoming().triagedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'triageStatus', 'ownerNote', 'triagedAt',
          'leadCompany', 'leadRole', 'leadSource', 'leadPriority',
          'leadNextAction', 'leadNextActionDueAtMs', 'leadOutcome'
        ])
        && incoming().triageStatus is string
        && incoming().triageStatus in ['new', 'replied', 'shortlisted', 'archived']
        && incoming().ownerNote is string
        && incoming().ownerNote.size() <= 1000
        && (!('leadCompany' in incoming()) || (incoming().leadCompany is string && incoming().leadCompany.size() <= 120))
        && (!('leadRole' in incoming()) || (incoming().leadRole is string && incoming().leadRole.size() <= 120))
        && (!('leadSource' in incoming()) || (incoming().leadSource is string && incoming().leadSource in ['', 'linkedin', 'referral', 'organic', 'other']))
        && (!('leadPriority' in incoming()) || (incoming().leadPriority is string && incoming().leadPriority in ['', 'hot', 'warm', 'cold']))
        && (!('leadNextAction' in incoming()) || (incoming().leadNextAction is string && incoming().leadNextAction.size() <= 200))
        && (!('leadNextActionDueAtMs' in incoming()) || (isWholeNumber(incoming().leadNextActionDueAtMs) && incoming().leadNextActionDueAtMs >= 0))
        && (!('leadOutcome' in incoming()) || (incoming().leadOutcome is string && incoming().leadOutcome in ['', 'open', 'interview', 'offer', 'closed_won', 'closed_lost']));

      allow delete: if isVerifiedUser()
        && isValidId(messageId)
        && isAdmin();
    }

    // Owner Admin Audit & Login History (strictly owner-only read/list/create/delete; immutable create)
    match /admin_audit_logs/{auditId} {
      allow get: if isVerifiedUser() && isValidId(auditId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(auditId)
        && isValidAdminAuditLog(incoming(), auditId)
        && incoming().createdAt == request.time
        && isAdmin();

      allow update: if false;

      allow delete: if isVerifiedUser()
        && isValidId(auditId)
        && isAdmin();
    }

    // Portfolio settings split:
    // - `public`: UX flags only (visitor-readable; no alert routing / rate caps / LLM model)
    // - `global`: full owner policy (primary-owner read/write only)
    function isValidPublicPortfolioSettings(data) {
      return data.keys().hasAll([
          'availabilityStatus', 'availabilityText', 'maintenanceMode', 'maintenanceMessage',
          'enableContactForm', 'enableCvDownloads', 'showAnnouncementsBadge',
          'enableAnnouncements', 'enableResumeStudio', 'enableDigitalCard', 'enableCommandPalette',
          'enableTerminal', 'enablePwaInstall', 'enableSkillFilter', 'enableReadingModes',
          'enableScrollHud', 'enableSiteTelemetry',
          'incidentMode', 'incidentMessage',
          'enablePortfolioChat', 'enableLiveChat',
          'chatShowSuggestions', 'chatOfferLiveAgent',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'availabilityStatus', 'availabilityText', 'maintenanceMode', 'maintenanceMessage',
          'enableContactForm', 'enableCvDownloads', 'showAnnouncementsBadge',
          'enableAnnouncements', 'enableResumeStudio', 'enableDigitalCard', 'enableCommandPalette',
          'enableTerminal', 'enablePwaInstall', 'enableSkillFilter', 'enableReadingModes',
          'enableScrollHud', 'enableSiteTelemetry',
          'incidentMode', 'incidentMessage',
          'enablePortfolioChat', 'enableLiveChat',
          'chatShowSuggestions', 'chatOfferLiveAgent',
          'updatedByUid', 'updatedAt'
        ])
        && data.availabilityStatus is string
        && data.availabilityStatus in ['open', 'advisory', 'unavailable']
        && data.availabilityText is string && data.availabilityText.size() <= 140
        && data.maintenanceMode is bool
        && data.maintenanceMessage is string && data.maintenanceMessage.size() <= 300
        && data.enableContactForm is bool
        && data.enableCvDownloads is bool
        && data.showAnnouncementsBadge is bool
        && data.enableAnnouncements is bool
        && data.enableResumeStudio is bool
        && data.enableDigitalCard is bool
        && data.enableCommandPalette is bool
        && data.enableTerminal is bool
        && data.enablePwaInstall is bool
        && data.enableSkillFilter is bool
        && data.enableReadingModes is bool
        && data.enableScrollHud is bool
        && data.enableSiteTelemetry is bool
        && data.incidentMode is bool
        && data.incidentMessage is string && data.incidentMessage.size() <= 300
        && data.enablePortfolioChat is bool
        && data.enableLiveChat is bool
        && data.chatShowSuggestions is bool
        && data.chatOfferLiveAgent is bool
        && (!('updatedByUid' in data) || (data.updatedByUid is string && data.updatedByUid.size() <= 128))
        && data.updatedAt is timestamp;
    }

    match /portfolio_settings/{settingsId} {
      // Visitors: public UX flags only. Owners: full global policy.
      allow get: if (settingsId == 'public')
        || (settingsId == 'global' && isVerifiedOwnerEmail());
      allow list: if false;

      allow create, update: if isVerifiedOwnerEmail()
        && (
          (settingsId == 'global'
            && isValidPortfolioSettings(incoming())
            && incoming().updatedAt == request.time)
          || (settingsId == 'public'
            && isValidPublicPortfolioSettings(incoming())
            && incoming().updatedAt == request.time)
        );

      allow delete: if false;
    }

    // Access rules: admins can read; only primary owner can create/delete (prevents delegate policy planting)
    match /access_rules/{ruleId} {
      allow get: if isVerifiedUser() && isValidId(ruleId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isVerifiedOwnerEmail()
        && isValidId(ruleId)
        && isValidAccessRule(incoming(), ruleId)
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedOwnerEmail()
        && isValidId(ruleId);
    }

    // Secondary admin delegates (primary owner manages roster; self-get for console access)
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isVerifiedOwnerEmail();
      allow create: if isVerifiedOwnerEmail()
        && isValidId(adminId)
        && isValidAdminRecord(incoming(), adminId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedOwnerEmail() && isValidId(adminId);
    }

    // Durable owner KPIs + chat snapshot (Admin SDK writes only; owner console may read).
    // Docs: owner_metrics/site (pageviews/OG), owner_metrics/chat_cache (sessions + counters).
    match /owner_metrics/{docId} {
      allow get: if isVerifiedUser() && isValidId(docId) && isAdmin()
        && (docId == 'site' || docId == 'chat_cache');
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Portfolio CMS entities — public read; admin create/update/delete.
    // Cloud docs merge over static seed data by id (including soft-delete tombstones).
    function isValidPortfolioString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function hasAuthorAndTimestamps(data) {
      return data.authorUid is string
        && data.authorUid.size() >= 1
        && data.authorUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /portfolio_certifications/{certId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && isValidId(certId)
        && isValidPortfolioString(incoming().title, 3, 180)
        && isValidPortfolioString(incoming().issuer, 2, 120)
        && isValidPortfolioString(incoming().issueDate, 3, 40)
        && incoming().category in ['ai', 'cloud', 'data']
        && incoming().skills is list
        && incoming().deleted is bool
        && hasAuthorAndTimestamps(incoming());
      allow delete: if isAdmin() && isValidId(certId);
    }

    match /portfolio_awards/{awardId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && isValidId(awardId)
        && isValidPortfolioString(incoming().title, 3, 180)
        && isValidPortfolioString(incoming().organization, 2, 120)
        && isValidPortfolioString(incoming().date, 3, 40)
        && isValidPortfolioString(incoming().description, 10, 600)
        && incoming().deleted is bool
        && hasAuthorAndTimestamps(incoming());
      allow delete: if isAdmin() && isValidId(awardId);
    }

    match /portfolio_recommendations/{recId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && isValidId(recId)
        && isValidPortfolioString(incoming().author, 2, 120)
        && isValidPortfolioString(incoming().role, 2, 160)
        && isValidPortfolioString(incoming().date, 3, 40)
        && isValidPortfolioString(incoming().quote, 20, 2000)
        && incoming().relationshipType in ['manager', 'direct_report', 'peer']
        && incoming().featured is bool
        && incoming().deleted is bool
        && hasAuthorAndTimestamps(incoming());
      allow delete: if isAdmin() && isValidId(recId);
    }

    match /portfolio_disciplines/{discId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && isValidId(discId)
        && isValidPortfolioString(incoming().title, 3, 120)
        && isValidPortfolioString(incoming().description, 10, 400)
        && incoming().technologies is list
        && isWholeNumber(incoming().level)
        && incoming().level >= 1
        && incoming().level <= 100
        && incoming().deleted is bool
        && hasAuthorAndTimestamps(incoming());
      allow delete: if isAdmin() && isValidId(discId);
    }

    match /portfolio_cisco_role/{roleId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && roleId == 'current'
        && incoming().highlights is list
        && incoming().technologies is list
        && hasAuthorAndTimestamps(incoming());
      allow delete: if isAdmin() && roleId == 'current';
    }

    match /portfolio_experience/{companyKey} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && companyKey in ['cisco', 'hcl', 'tcs']
        && incoming().companyKey == companyKey
        && incoming().roles is list
        && incoming().roles.size() >= 1
        && incoming().roles.size() <= 12
        && hasAuthorAndTimestamps(incoming());
      allow delete: if isAdmin() && companyKey in ['cisco', 'hcl', 'tcs'];
    }
  }
}
