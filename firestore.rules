rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Zero-DB-read owner identity check for list rules (Denial-of-Wallet & Pillar 8 compliant)
    function isVerifiedOwnerEmail() {
      return isVerifiedUser() && request.auth.token.email == 'sufyan.net@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'sufyan.net@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Strict schema validation blueprint for Announcement (create & update)
    function isValidAnnouncement(data) {
      return data.keys().hasAll(['date', 'title', 'summary', 'badge', 'linkUrl', 'authorUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['date', 'title', 'summary', 'badge', 'linkUrl', 'authorUid', 'createdAt', 'updatedAt'])
        && data.date is string
        && data.date.size() >= 3
        && data.date.size() <= 40
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 180
        && data.summary is string
        && data.summary.size() >= 10
        && data.summary.size() <= 600
        && data.badge is string
        && data.badge.size() >= 5
        && data.badge.size() <= 16
        && data.badge in ['VERIFIED', 'MILESTONE', 'CERTIFICATION', 'AWARD', 'PUBLICATION']
        && data.linkUrl is string
        && data.linkUrl.size() <= 300
        && (data.linkUrl == '' || data.linkUrl.matches('^https://[^\\s]+$'))
        && data.authorUid is string
        && data.authorUid.size() >= 1
        && data.authorUid.size() <= 128
        && data.authorUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Strict schema validation blueprint for CvDownloadLog (immutable create)
    function isValidCvDownloadLog(data, pathId) {
      return data.keys().hasAll([
          'downloadId', 'sessionId', 'visitorName', 'visitorEmail', 'visitorPhone',
          'reason', 'action', 'formatLabel', 'theme', 'verificationStatus',
          'ipAddress', 'country', 'region', 'city', 'isp', 'asn',
          'timezone', 'clientTimezone', 'isVpnSuspected', 'isProxy',
          'isHosting', 'timezoneMismatch', 'riskLevel', 'riskReasons',
          'referrer', 'userAgent', 'isSubsequent', 'createdAt'
        ])
        && data.keys().hasOnly([
          'downloadId', 'sessionId', 'visitorName', 'visitorEmail', 'visitorPhone',
          'reason', 'action', 'formatLabel', 'theme', 'verificationStatus',
          'ipAddress', 'country', 'region', 'city', 'isp', 'asn',
          'timezone', 'clientTimezone', 'isVpnSuspected', 'isProxy',
          'isHosting', 'timezoneMismatch', 'riskLevel', 'riskReasons',
          'referrer', 'userAgent', 'isSubsequent', 'createdAt'
        ])
        && data.downloadId is string
        && data.downloadId == pathId
        && data.downloadId.size() >= 4
        && data.downloadId.size() <= 64
        && data.downloadId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.sessionId is string
        && data.sessionId.size() >= 4
        && data.sessionId.size() <= 64
        && data.sessionId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.visitorName is string && data.visitorName.size() <= 120
        && data.visitorEmail is string && data.visitorEmail.size() <= 254
        && data.visitorPhone is string && data.visitorPhone.size() <= 40
        && (data.visitorEmail.size() > 0 || data.visitorPhone.size() > 0)
        && data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 500
        && data.action is string && data.action.size() >= 3 && data.action.size() <= 16
        && data.action in ['pdf', 'print', 'ats', 'install']
        && data.formatLabel is string && data.formatLabel.size() >= 2 && data.formatLabel.size() <= 80
        && data.theme is string && data.theme.size() >= 4 && data.theme.size() <= 8
        && data.theme in ['dark', 'light']
        && data.verificationStatus is string && data.verificationStatus.size() >= 4 && data.verificationStatus.size() <= 24
        && data.verificationStatus in ['otp_verified', 'mx_verified', 'phone_only', 'repeat_session']
        && data.ipAddress is string && data.ipAddress.size() <= 64
        && data.country is string && data.country.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.city is string && data.city.size() <= 80
        && data.isp is string && data.isp.size() <= 120
        && data.asn is string && data.asn.size() <= 64
        && data.timezone is string && data.timezone.size() <= 64
        && data.clientTimezone is string && data.clientTimezone.size() <= 64
        && data.isVpnSuspected is bool
        && data.isProxy is bool
        && data.isHosting is bool
        && data.timezoneMismatch is bool
        && data.riskLevel is string && data.riskLevel.size() >= 3 && data.riskLevel.size() <= 10
        && data.riskLevel in ['low', 'medium', 'high']
        && data.riskReasons is string && data.riskReasons.size() <= 240
        && data.referrer is string && data.referrer.size() <= 200
        && data.userAgent is string && data.userAgent.size() <= 220
        && data.isSubsequent is bool
        && data.createdAt is timestamp;
    }

    // Portfolio Announcements (public non-PII read; owner-only verified mutations)
    // Evaluation order: Auth -> Static Validation -> Admin Check (Denial-of-Wallet guard)
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId);
      allow list: if true;

      allow create: if isVerifiedUser()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();

      allow update: if isVerifiedUser()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'title', 'summary', 'badge', 'linkUrl', 'updatedAt'])
        && isAdmin();

      allow delete: if isVerifiedUser()
        && isValidId(announcementId)
        && isAdmin();
    }

    // CV Download & Export Audit Telemetry (PII-isolated: owner-only read/list/delete; immutable create)
    match /cv_downloads/{downloadId} {
      allow get: if isVerifiedUser() && isValidId(downloadId) && isAdmin();
      allow list: if isVerifiedOwnerEmail();

      allow create: if isValidId(downloadId)
        && isValidCvDownloadLog(incoming(), downloadId)
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser()
        && isValidId(downloadId)
        && isAdmin();
    }

    // Admin allowlist (strictly non-writable and non-enumerable from client SDKs)
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
