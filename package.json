{
  "name": "sufyan-portfolio",
  "private": true,
  "version": "1.1.10",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production node --import tsx server.ts",
    "build": "node scripts/write-vite-public-env.mjs && vite build",
    "predev": "node scripts/write-vite-public-env.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "prelint": "node scripts/write-vite-public-env.mjs --stub",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint --no-error-on-unmatched-pattern \"**/*.rules\"",
    "pretest": "node scripts/write-vite-public-env.mjs --stub",
    "test": "vitest run",
    "test:watch": "node scripts/write-vite-public-env.mjs --stub && vitest",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "precommit": "bash ./scripts/pre-commit.sh",
    "release": "bash ./scripts/release.sh",
    "firebase:login": "firebase login",
    "firebase:deploy-rules": "GOOGLE_CLOUD_QUOTA_PROJECT=mohammed-sufyan-portfolio firebase deploy --only firestore:rules --project mohammed-sufyan-portfolio",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.6",
    "@upstash/redis": "^1.41.0",
    "@upstash/vector": "^1.2.4",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "libphonenumber-js": "^1.13.17",
    "nodemailer": "^10.6.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.15.0",
    "html2canvas-pro": "^2.6.4",
    "husky": "^9.1.7",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "picomatch": "4.0.7",
    "@grpc/grpc-js": "^1.14.7"
  }
}
